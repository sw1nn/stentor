# Maintainer: Neale Swinnerton <neale@sw1nn.com>
pkgname=stentor
pkgver=0.32.0
pkgrel=1
pkgdesc="Real-time voice transcription with Whisper"
arch=('x86_64')
url="https://code.sw1nn.net/sw1nn/stentor"
license=('GPL3')
depends=('gtk4' 'libadwaita' 'fontconfig' 'libpulse' 'vulkan-icd-loader')
makedepends=('cargo' 'git' 'clang' 'cmake' 'vulkan-headers' 'shaderc')
options=('!lto' '!debug')
conflicts=('sw1nn-transcription' 'sw1nn-transcription-git')
source=("$pkgname::git+https://code.sw1nn.net/sw1nn/stentor.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
  cd "$srcdir/$pkgname"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_HOME="$srcdir/cargo-home"
  # Unset CARGO_TARGET_DIR to use local target directory
  unset CARGO_TARGET_DIR
  # Remove system LTO flags that interfere with whisper's native compilation
  export CFLAGS="${CFLAGS//-flto=auto/}"
  export CXXFLAGS="${CXXFLAGS//-flto=auto/}"
  # Remap source paths to avoid $srcdir references in binaries
  export RUSTFLAGS="--remap-path-prefix=$srcdir=/usr/src/debug/$pkgname"

  cargo build --frozen --release
}

# Tests disabled - require runtime environment
# check() {
#   cd "$srcdir/$pkgname"
#   export RUSTUP_TOOLCHAIN=stable
#   export CARGO_HOME="$srcdir/cargo-home"
#   cargo test --frozen --release
# }

package() {
  cd "$srcdir/$pkgname"

  # Install binaries
  install -Dm755 "target/release/stentord" "$pkgdir/usr/bin/stentord"
  install -Dm755 "target/release/stentorctl" "$pkgdir/usr/bin/stentorctl"

  # Generate and install shell completions for stentorctl
  local BIN="target/release/stentorctl"
  "$BIN" completions bash | install -Dm0644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/stentorctl"
  "$BIN" completions zsh  | install -Dm0644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_stentorctl"
  "$BIN" completions fish | install -Dm0644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/stentorctl.fish"

  # Install systemd user service
  install -Dm644 "$srcdir/$pkgname/assets/stentor.service" "$pkgdir/usr/lib/systemd/user/stentor.service"

  # Install sample config
  install -Dm644 "config.toml.sample" "$pkgdir/usr/share/doc/$pkgname/config.toml.sample"
}
