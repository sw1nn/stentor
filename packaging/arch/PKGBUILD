# Maintainer: Neale Swinnerton <neale@sw1nn.com>
pkgname=stentor
pkgver=0.21.0
pkgrel=1
pkgdesc="Real-time voice transcription with Whisper"
arch=('x86_64')
url="https://git.sw1nn.net/r/stentor.git"
license=('GPL3')
depends=('gtk4' 'libadwaita' 'alsa-lib')
makedepends=('cargo' 'git')
options=('!lto' '!debug')
conflicts=('sw1nn-transcription' 'sw1nn-transcription-git')
source=("$pkgname::git+ssh://git.sw1nn.net/sw1nn/stentor.git#tag=v$pkgver"
  "stentor.service")
sha256sums=('SKIP'
  '7f6bbf0d1cc7f2426395e31189db911dd51555738fe82b1dd3ec99f52c723392')

prepare() {
  cd "$srcdir/$pkgname"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_HOME="$srcdir/cargo-home"
  # Unset CARGO_TARGET_DIR to use local target directory
  unset CARGO_TARGET_DIR
  # Remove system LTO flags that interfere with whisper's native compilation
  export CFLAGS="${CFLAGS//-flto=auto/}"
  export CXXFLAGS="${CXXFLAGS//-flto=auto/}"

  cargo build --frozen --release
}

# Tests disabled - require runtime environment
# check() {
#   cd "$srcdir/$pkgname"
#   export RUSTUP_TOOLCHAIN=stable
#   export CARGO_HOME="$srcdir/cargo-home"
#   cargo test --frozen --release
# }

package() {
  cd "$srcdir/$pkgname"

  # Install binaries
  install -Dm755 "target/release/stentord" "$pkgdir/usr/bin/stentord"
  install -Dm755 "target/release/stentorctl" "$pkgdir/usr/bin/stentorctl"

  # Install systemd user service
  install -Dm644 "$srcdir/stentor.service" "$pkgdir/usr/lib/systemd/user/stentor.service"

  # Install sample config
  install -Dm644 "config.toml.sample" "$pkgdir/usr/share/doc/$pkgname/config.toml.sample"
}
